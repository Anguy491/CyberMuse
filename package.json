{
  "name": "cybermuse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.16.0"
  },
  "scripts": {
    "analyzer:check": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File tooling/m4-analyzer-check.ps1",
    "build": "pnpm --filter @cybermuse/desktop build",
    "build:analyzer": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File tooling/build-m4-analyzer.ps1",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:contracts && pnpm license:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "license:check": "node tooling/check-licenses.mjs",
    "lint": "eslint . --max-warnings 0",
    "prepare:m4:clean-windows": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File tooling/prepare-m4-clean-windows.ps1",
    "prepare:m6:clean-windows": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File tooling/prepare-m6-clean-windows.ps1",
    "prepare:m6:installer": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File tooling/prepare-m6-installer.ps1",
    "release:assets": "node tooling/m6-release-assets.mjs",
    "release:manifest": "node tooling/m6-release-assets.mjs --finalize",
    "build:m6": "pnpm build:analyzer && pnpm prepare:m6:installer && pnpm tauri build && pnpm release:manifest",
    "tauri": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File tooling/tauri.ps1",
    "test": "vitest run --config tooling/vitest.unit.config.ts",
    "test:contracts": "vitest run --config tooling/vitest.contract.config.ts",
    "test:m2:performance": "vite build --config tooling/vite.m2-benchmark.config.ts && node artifacts/m2/benchmark-bundle/m2-realtime-benchmark.mjs",
    "test:m2:quality": "vite build --config tooling/vite.m2-quality.config.ts && node artifacts/m2/quality-bundle/m2-quality-report.mjs",
    "test:m3:a11y": "vitest run apps/desktop/src/pages/PracticePage.test.tsx apps/desktop/src/signal-ui.test.ts --config tooling/vitest.unit.config.ts",
    "test:m3:performance": "vite build --config tooling/vite.m3-performance.config.ts && node artifacts/m3/performance-bundle/m3-performance-report.mjs",
    "test:m3:quality": "vite build --config tooling/vite.m3-quality.config.ts && node artifacts/m3/quality-bundle/m3-quality-report.mjs",
    "test:m4:contracts": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File tooling/m4-contracts.ps1",
    "test:m4:network": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File tooling/m4-network.ps1",
    "test:m4:performance": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File tooling/m4-analyzer-performance.ps1",
    "test:m4:quality": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File tooling/m4-quality.ps1",
    "test:m4:supply": "node tooling/m4-supply-chain.mjs",
    "test:m5:import": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File tooling/m5-import-integration.ps1",
    "test:m6:supply": "node tooling/m6-release-assets.mjs",
    "test:m6:installer": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File tooling/m6-installer-smoke.ps1",
    "test:m6:privacy": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File tooling/m6-privacy.ps1",
    "test:m6:clean-windows": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File artifacts/m6/clean-windows-package/m6-clean-windows-smoke.ps1 -PackageRoot artifacts/m6/clean-windows-package -EvidencePath artifacts/m6/clean-windows-package/m6-clean-windows-evidence.json",
    "test:m6:soak": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File tooling/m6-windows-soak.ps1",
    "test:m8:performance": "vite build --config tooling/vite.m8-performance.config.ts && node artifacts/m8/performance-bundle/m8-pitch-lane-performance.mjs",
    "test:m8:quality": "vite build --config tooling/vite.m8-quality.config.ts && node artifacts/m8/quality-bundle/m8-pitch-quality.mjs",
    "test:m9:docs": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File tooling/m9-document-readiness.ps1",
    "test:m10:docs": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File tooling/m10-document-readiness.ps1",
    "typecheck": "tsc --noEmit -p packages/domain/tsconfig.json && tsc --noEmit -p packages/contracts/tsconfig.json && tsc --noEmit -p packages/audio/tsconfig.json && tsc --noEmit -p packages/scoring/tsconfig.json && tsc --noEmit -p apps/desktop/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
