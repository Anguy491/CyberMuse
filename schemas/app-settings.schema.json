{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybermuse.local/schemas/app-settings.schema.json",
  "title": "CyberMuse AppSettings v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "revision",
    "inputDeviceFingerprint",
    "outputDeviceFingerprint",
    "volume",
    "themePreference",
    "motionPreference",
    "modelCacheSelection",
    "latencyCalibrations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "inputDeviceFingerprint": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/fingerprint" }]
    },
    "outputDeviceFingerprint": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/fingerprint" }]
    },
    "volume": { "type": "number", "minimum": 0, "maximum": 1 },
    "themePreference": { "enum": ["system", "dark", "light"] },
    "motionPreference": { "enum": ["system", "reduce", "full"] },
    "languagePreference": { "enum": ["system", "zh-CN", "en-US"] },
    "modelCacheSelection": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9._-]+@[a-zA-Z0-9._-]+$"
      }
    },
    "latencyCalibrations": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/calibration" }
    }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "calibration": {
      "type": "object",
      "required": [
        "calibrationId",
        "inputDeviceFingerprint",
        "outputDeviceFingerprint",
        "sampleRateHz",
        "latencyMs",
        "source",
        "confidence",
        "measuredAt"
      ],
      "properties": {
        "calibrationId": { "type": "string", "format": "uuid" },
        "inputDeviceFingerprint": { "$ref": "#/$defs/fingerprint" },
        "outputDeviceFingerprint": { "$ref": "#/$defs/fingerprint" },
        "sampleRateHz": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 192000
        },
        "latencyMs": { "type": "integer", "minimum": -250, "maximum": 2000 },
        "source": { "enum": ["measured", "manual"] },
        "confidence": {
          "anyOf": [
            { "type": "null" },
            { "type": "number", "minimum": 0, "maximum": 1 }
          ]
        },
        "measuredAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "source": { "const": "measured" } } },
          "then": {
            "properties": {
              "latencyMs": { "minimum": 0, "maximum": 2000 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        {
          "if": { "properties": { "source": { "const": "manual" } } },
          "then": {
            "properties": {
              "latencyMs": { "minimum": -250, "maximum": 500 },
              "confidence": { "type": "null" }
            }
          }
        }
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
