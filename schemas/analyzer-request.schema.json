{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybermuse.local/schemas/analyzer-request.schema.json",
  "title": "CyberMuse AnalyzerRequest",
  "type": "object",
  "required": [
    "schemaVersion",
    "jobId",
    "songId",
    "requestedAnalysisId",
    "inputPath",
    "stagingPath",
    "expectedDurationMs",
    "pipelineVersion",
    "roots",
    "models",
    "tools",
    "config"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "jobId": { "type": "string", "format": "uuid" },
    "songId": { "$ref": "#/$defs/sha256" },
    "requestedAnalysisId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "inputPath": { "$ref": "#/$defs/absoluteWindowsPath" },
    "stagingPath": { "$ref": "#/$defs/absoluteWindowsPath" },
    "expectedDurationMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1200000
    },
    "pipelineVersion": { "type": "string", "minLength": 1 },
    "roots": {
      "type": "object",
      "required": ["songRoot", "stagingRoot", "modelRoot", "toolRoot"],
      "properties": {
        "songRoot": { "$ref": "#/$defs/absoluteWindowsPath" },
        "stagingRoot": { "$ref": "#/$defs/absoluteWindowsPath" },
        "modelRoot": { "$ref": "#/$defs/absoluteWindowsPath" },
        "toolRoot": { "$ref": "#/$defs/absoluteWindowsPath" }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/model" }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/tool" }
    },
    "config": {
      "type": "object",
      "required": [
        "sampleRateHz",
        "pitchMinHz",
        "pitchMaxHz",
        "confidenceThreshold",
        "maxInterpolatedGapMs"
      ],
      "properties": {
        "sampleRateHz": { "const": 48000 },
        "pitchMinHz": { "type": "number", "exclusiveMinimum": 0 },
        "pitchMaxHz": { "type": "number", "exclusiveMinimum": 0 },
        "confidenceThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxInterpolatedGapMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "absoluteWindowsPath": {
      "type": "string",
      "pattern": "^[A-Za-z]:[\\\\/].+"
    },
    "model": {
      "type": "object",
      "required": [
        "modelId",
        "version",
        "engine",
        "path",
        "sha256",
        "licenseExpression"
      ],
      "properties": {
        "modelId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "engine": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/absoluteWindowsPath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "licenseExpression": { "type": "string", "minLength": 1 }
      }
    },
    "tool": {
      "type": "object",
      "required": ["toolId", "version", "path", "sha256"],
      "properties": {
        "toolId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/absoluteWindowsPath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
