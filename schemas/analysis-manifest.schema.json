{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybermuse.local/schemas/analysis-manifest.schema.json",
  "title": "CyberMuse AnalysisManifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "analysisId",
    "songId",
    "inputSha256",
    "createdAt",
    "pipelineVersion",
    "configFingerprint",
    "durationMs",
    "models",
    "artifacts",
    "referenceTrackRelativePath",
    "warnings"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "analysisId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "songId": { "$ref": "#/$defs/sha256" },
    "inputSha256": { "$ref": "#/$defs/sha256" },
    "createdAt": { "type": "string", "format": "date-time" },
    "pipelineVersion": { "type": "string", "minLength": 1 },
    "configFingerprint": { "$ref": "#/$defs/sha256" },
    "durationMs": { "type": "integer", "minimum": 1, "maximum": 1200000 },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/model" }
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "referenceTrackRelativePath": { "$ref": "#/$defs/relativePath" },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "model": {
      "type": "object",
      "required": [
        "modelId",
        "version",
        "engine",
        "sha256",
        "licenseExpression"
      ],
      "properties": {
        "modelId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "engine": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "licenseExpression": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "kind",
        "relativePath",
        "mediaType",
        "sizeBytes",
        "sha256",
        "durationMs",
        "sampleRateHz",
        "channels"
      ],
      "properties": {
        "kind": { "enum": ["instrumental", "vocals", "reference_track"] },
        "relativePath": { "$ref": "#/$defs/relativePath" },
        "mediaType": { "type": "string", "minLength": 1 },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "durationMs": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 1200000
        },
        "sampleRateHz": { "type": ["integer", "null"], "minimum": 1 },
        "channels": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "warning": {
      "type": "object",
      "required": ["code", "messageKey", "safeDetails"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "messageKey": { "type": "string", "minLength": 1 },
        "safeDetails": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean"]
          }
        }
      }
    }
  }
}
